NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4.1-mini
DEEPGRAM_API_KEY=your-deepgram-key
DEEPGRAM_MODEL=nova-3

# Optional TTS overrides. Leave unset to use the built-in default voice per course.
# Add a backup model if you want Deepgram failover without browser speech.
# DEEPGRAM_TTS_JAPANESE_PRIMARY_MODEL=aura-2-izanami-ja
# DEEPGRAM_TTS_JAPANESE_BACKUP_MODEL=your-backup-ja-model
# DEEPGRAM_TTS_ENGLISH_PRIMARY_MODEL=aura-2-thalia-en
# DEEPGRAM_TTS_ENGLISH_BACKUP_MODEL=your-backup-en-model
# DEEPGRAM_TTS_GERMAN_PRIMARY_MODEL=aura-2-viktoria-de
# DEEPGRAM_TTS_GERMAN_BACKUP_MODEL=your-backup-de-model
# DEEPGRAM_TTS_FRENCH_PRIMARY_MODEL=aura-2-agathe-fr
# DEEPGRAM_TTS_FRENCH_BACKUP_MODEL=your-backup-fr-model
# DEEPGRAM_TTS_SPANISH_PRIMARY_MODEL=aura-2-celeste-es
